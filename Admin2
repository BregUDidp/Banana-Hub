-- ฟังก์ชันสร้างปุ่ม Toggle ทั่วไป
local function createToggleButton(title, onToggle)
    local state = false
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 35)
    frame.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    frame.Parent = scrollingFrame

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 8)
    fCorner.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 90, 1, -10)
    btn.Position = UDim2.new(1, -95, 0, 5)
    btn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = frame

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -105, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = title
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local function setToggleState(newState)
        state = newState
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
            btn.Text = "ON"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
            btn.Text = "OFF"
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end

    btn.MouseButton1Click:Connect(function()
        setToggleState(not state)
        onToggle(state)
    end)

    return {
        SetState = function(newState)
            setToggleState(newState)
        end
    }
end

-- ฟังก์ชันสร้างปุ่ม Toggle + ช่องใส่ Power / Input
local function createPowerToggleButton(title, defaultVal, placeholder, onToggle)
    local state = false
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 35)
    frame.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    frame.Parent = scrollingFrame

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 8)
    fCorner.Parent = frame

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(0, 80, 1, -10)
    textBox.Position = UDim2.new(1, -180, 0, 5)
    textBox.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    textBox.PlaceholderText = placeholder or "Power..."
    textBox.Text = defaultVal and tostring(defaultVal) or ""
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.Font = Enum.Font.Gotham
    textBox.TextSize = 12
    textBox.Parent = frame

    local tbCorner = Instance.new("UICorner")
    tbCorner.CornerRadius = UDim.new(0, 6)
    tbCorner.Parent = textBox

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 90, 1, -10)
    btn.Position = UDim2.new(1, -95, 0, 5)
    btn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = frame

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -190, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = title
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    btn.MouseButton1Click:Connect(function()
        state = not state
        local inputVal = textBox.Text
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
            btn.Text = "ON"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
            btn.Text = "OFF"
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        onToggle(state, inputVal)
    end)
    
    textBox.FocusLost:Connect(function()
        if state then
            onToggle(true, textBox.Text)
        end
    end)
end

