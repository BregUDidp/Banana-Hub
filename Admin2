-- ================== รับคำสั่งจากแชท ==================
player.Chatted:Connect(function(message)
    local msg = message:lower()
    local args = message:split(" ")
    
    -- คำสั่ง /chat [text] และเปิดปิด GUI ผ่านแชท
    if message:sub(1, 6):lower() == "/chat " then
        local chatText = message:sub(7)
        executeChat(chatText)
    elseif msg == "/chatgui" or msg == "/chat" then
        if customChatGuiInstance then
            hideCustomChatGUI()
        else
            showCustomChatGUI()
        end
    elseif msg == "/unchatgui" or msg == "/unchat" then
        hideCustomChatGUI()
        
    elseif msg == "/noclip" or msg == "/nc" then
        enableNoclip()
    elseif msg == "/unnoclip" or msg == "/unnc" then
        disableNoclip()
        
    elseif msg == "/fly" or msg:match("^/fly%s*%d*$") then
        local speed = msg:match("/fly%s*(%d+)")
        startFlying(speed)
        
    elseif msg == "/unfly" then
        stopFlying()
        
    elseif msg == "/spin" or msg:match("^/spin%s*%-?%d+$") then
        local speed = msg:match("/spin%s*(%-?%d+)")
        startSpinning(speed)
        
    elseif msg == "/unspin" then
        stopSpinning()
        
    elseif msg:match("^/speed%s*%d+$") then
        local speed = msg:match("/speed%s*(%d+)")
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then humanoid.WalkSpeed = tonumber(speed) or 16 end
        end
        
    elseif msg:match("^/jump%s*%d+$") then
        local power = msg:match("/jump%s*(%d+)")
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then humanoid.JumpPower = tonumber(power) or 50 end
        end
        
    elseif args[1] == "/tp" and args[2] then
        teleportToPlayer(args[2])
        
    elseif msg == "/tooltp" then
        giveTeleportTool()
        
    elseif msg == "/toolrecoil" then
        giveRecoilTool()
        
    elseif msg == "/rejoin" or msg == "/rj" then
        TeleportService:Teleport(game.PlaceId, player)
        
    elseif msg == "/freeze" then
        freezePlayer()
    elseif msg == "/unfreeze" then
        unfreezePlayer()
    elseif msg == "/sit" then
        ToggleSit(true)
    elseif msg == "/unsit" then
        ToggleSit(false)
    elseif msg == "/infinitejump" or msg == "/if" then
        enableInfiniteJump()
    elseif msg == "/uninfinitejump" or msg == "/unif" then
        disableInfiniteJump()
    elseif msg == "/invisible" or msg == "/iv" then
        makeInvisible()
    elseif msg == "/uninvisible" or msg == "/univ" then
        makeVisible()
    elseif msg == "/infiniteyield" or msg == "/iy" then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()
    elseif msg == "/flingscript" or msg == "/fs" then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/SVG-CARLOS/I-spent-soo-much-time-making-this-script-that-I-cant-make-a-good-title/refs/heads/main/Invisfling"))()
    elseif msg == "/animation" or msg == "/an" then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/BregUDidp/Banana-Hub/refs/heads/main/Animation"))()
    end
end)

